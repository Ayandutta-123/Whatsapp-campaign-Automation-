# Copy this file to .env and fill in your values

PORT=3001
# Local Mac (npm run dev): NODE_ENV=development
# On-prem / Docker: production — Docker Compose and the app force this even if
# a copied .env still says development.
NODE_ENV=production

# Host port published outside Docker (on-prem reverse proxy / panel).
# Example: app reachable on host :8014 while container listens on 3001.
# PORT_whatsapp_automation=8014

# PostgreSQL — host depends on how you run it:
#   Default Compose service name:  postgres
#   Custom / on-prem DNS name:     whatsapp_postgres (set in DATABASE_URL)
#   Local npm + Compose DB only:   localhost
POSTGRES_USER=whatsapp_user
POSTGRES_PASSWORD=hyperthink2025
POSTGRES_DB=whatsapp_db
DATABASE_URL=postgresql://whatsapp_user:hyperthink2025@postgres:5432/whatsapp_db
DATABASE_SSL=false

JWT_SECRET=generate_with_openssl_rand_hex_32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YourSecurePassword123
JWT_EXPIRES_IN=8h

# Behind nginx/Caddy set TRUST_PROXY=true
# TRUST_PROXY=false

# WhatsApp API — optional bootstrap (Settings UI is the primary place to configure)
# WHATSAPP_TOKEN=your_permanent_or_temporary_token_from_meta
# PHONE_NUMBER_ID=your_phone_number_id
# WABA_ID=your_whatsapp_business_account_id
# META_APP_ID=your_facebook_app_id_from_developers_facebook_com

# Public URL users and Meta reach (no trailing slash).
# Flexible: set here and/or in Settings → Public App URL (no code change).
APP_PUBLIC_URL=https://whatsapp.yourcompany.com
BASE_URL=https://whatsapp.yourcompany.com

# ── Split-host deploys only (UI served from a different domain than the API) ──
# The standard deploy serves UI + API on one port, so both of these stay empty.
#
# 1) Browser origins allowed to call the API. Comma-separated; `*` allows any.
#    APP_PUBLIC_URL and BASE_URL are always allowed automatically.
# CORS_ORIGINS=https://ui.yourcompany.com,https://staging-ui.yourcompany.com
#
# 2) API URL baked into the UI at BUILD time (rebuild the client after changing).
#    Leave empty so the UI calls /api on whatever host serves it.
# VITE_API_BASE_URL=https://whatsapp.yourcompany.com

# Required in production for webhook signature verification (HMAC)
# META_APP_SECRET=your_app_secret_from_developers_facebook_com

# Graph API version (default v21.0)
# META_GRAPH_VERSION=v21.0

# API rate limits (authenticated SPA polls often — keep API roomy; login stays stricter)
# API_RATE_LIMIT=8000
# AUTH_RATE_LIMIT=30

# On-prem storage paths (absolute, or relative to project root). Defaults: ./uploads, ./backups
# UPLOADS_DIR=/var/lib/whatsapp-automation/uploads
# BACKUPS_DIR=/var/lib/whatsapp-automation/backups

# Anthropic Claude — template AI assistant (or set in Settings UI)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Optional: Docker Hub image name (build & deploy)
# DOCKER_IMAGE=yourdockerhubuser/whatsapp-campaign-automation:latest
