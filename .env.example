# Copy this file to .env and fill in your values

PORT=3001
NODE_ENV=production

# PostgreSQL — host depends on how you run it:
#   Docker Compose (app + postgres):  postgres
#   Postgres on same machine as Node: localhost
#   Dev: docker compose up postgres -d  →  localhost
POSTGRES_PASSWORD=hyperthink2025
DATABASE_URL=postgresql://whatsapp_user:hyperthink2025@postgres:5432/whatsapp_db
DATABASE_SSL=false

JWT_SECRET=generate_with_openssl_rand_hex_32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YourSecurePassword123
JWT_EXPIRES_IN=8h

# Behind nginx/Caddy set TRUST_PROXY=true
# TRUST_PROXY=false

# WhatsApp API — optional bootstrap (Settings UI is the primary place to configure)
# WHATSAPP_TOKEN=your_permanent_or_temporary_token_from_meta
# PHONE_NUMBER_ID=your_phone_number_id
# WABA_ID=your_whatsapp_business_account_id
# META_APP_ID=your_facebook_app_id_from_developers_facebook_com

# Public URL users and Meta reach (no trailing slash). Set in Settings UI or here.
APP_PUBLIC_URL=https://whatsapp.yourcompany.com
BASE_URL=https://whatsapp.yourcompany.com

# Required in production for webhook signature verification (HMAC)
# META_APP_SECRET=your_app_secret_from_developers_facebook_com

# Graph API version (default v21.0)
# META_GRAPH_VERSION=v21.0

# API rate limits (authenticated SPA polls often — keep API roomy; login stays stricter)
# API_RATE_LIMIT=8000
# AUTH_RATE_LIMIT=30

# On-prem storage paths (absolute, or relative to project root). Defaults: ./uploads, ./backups
# UPLOADS_DIR=/var/lib/whatsapp-automation/uploads
# BACKUPS_DIR=/var/lib/whatsapp-automation/backups

# Anthropic Claude — template AI assistant (or set in Settings UI)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Optional: Docker Hub image name (build & deploy)
# DOCKER_IMAGE=yourdockerhubuser/whatsapp-campaign-automation:latest
